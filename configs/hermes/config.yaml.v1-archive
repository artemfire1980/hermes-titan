_config_version: 42
agent:
  disabled_toolsets:
  - video
  - video_gen
  - tts
  - stt
  - computer_use
  - browser-use
  max_tool_iterations: 30
approvals:
  destructive_slash_confirm: false
  mode: smart
curator:
  backup:
    enabled: true
    keep: 5
  consolidate: false
  prune_builtins: false
mcp_servers:
  context7:
    args:
    - /home/khadas/.hermes/mcp-servers/node_modules/@upstash/context7-mcp/dist/index.js
    command: /home/khadas/.hermes/node/bin/node
    connect_timeout: 60
    env:
      PATH: /home/khadas/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin
    timeout: 120
model:
  base_url: http://127.0.0.1:3001/v1
  context_length: 65536
  default: auto
  provider: freellmapi
onboarding:
  seen:
    busy_input_prompt: true
plugins:
  enabled: []
providers:
  freellmapi:
    api: http://127.0.0.1:3001/v1
    key_env: OPENAI_API_KEY
skills:
  guard_agent_created: true
  write_approval: true
web:
  search_backend: searxng
streaming:
  enabled: true
  transport: edit
  edit_interval: 0.8
  buffer_threshold: 32
  cursor: " ▉"
display:
  interim_assistant_messages: true


delegation:
  max_concurrent_children: 1
  max_spawn_depth: 1
  orchestrator_enabled: false
  compression_threshold_tokens: 24000
